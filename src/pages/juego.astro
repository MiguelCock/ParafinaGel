---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import GameExperience from "@components/game/GameExperience.svelte";
import PageHero from "@components/PageHero.astro";
import SectionHeading from "@components/SectionHeading.astro";

const pasos = [
  {
    title: "Escucha",
    text: "El cliente revela el brief poco a poco: tipo de vela, colores, aroma, mecha y acabado.",
  },
  {
    title: "Diseña y crea",
    text: "Arma capas, figuras o gel; calienta, vierte, coloca la mecha y cuida cada detalle con gestos manuales.",
  },
  {
    title: "Pide tus insumos",
    text: "Recibe la receta con cantidades y pide los materiales para hacerla en casa.",
  },
];
---

<BaseLayout
  title="Juego"
  description="Juega a preparar velas en el taller 2D de ParafinaGel."
>
  <PageHero
    eyebrow="Juego"
    title="Diseña la vela. Compra los insumos."
    description="Una experiencia cozy en 2D WebGL: escucha un brief, diseña por capas, figuras o gel, y recibe la receta con todo lo que necesitas para hacerla."
    align="center"
  />

  <section class="section game-section">
    <div class="container">
      <GameExperience client:visible />
      <p class="game-disclaimer">
        Juego con contenido de ejemplo. Los tiempos, temperaturas, materiales y
        cantidades son aproximados; los datos reales se validarán con el negocio
        antes de publicar. El taller interactivo usa WebGL y tiene un modo de
        respaldo sin WebGL.
      </p>
    </div>
  </section>

  <section class="section section--tight how">
    <div class="container">
      <SectionHeading
        eyebrow="Cómo funciona"
        title="Tres momentos, una receta"
        align="center"
      />

      <div class="how__grid">
        {pasos.map((paso, index) => (
          <article class="how__card">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{paso.title}</h3>
            <p>{paso.text}</p>
          </article>
        ))}
      </div>

      <div class="how__cta">
        <Button href="/productos" variant="secondary">
          Explorar el catálogo
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .game-disclaimer {
    max-width: 62ch;
    margin: var(--space-4) auto 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .how {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .how__grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .how__card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .how__card span {
    display: inline-block;
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .how__card h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .how__card p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .how__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-6);
  }

  @media (min-width: 760px) {
    .how__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
