---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import WhatsAppCTA from "@components/WhatsAppCTA.astro";
import { site } from "@config/site";
import { whatsappLink } from "@lib/whatsapp";

const whatsapp = whatsappLink(
  "Hola, quiero información sobre las velas de ParafinaGel.",
);

const faqs = [
  {
    question: "¿Hacen envíos?",
    answer:
      "Escríbenos con tu ciudad y te confirmamos disponibilidad, tiempo y costo de envío.",
  },
  {
    question: "¿Puedo pedir un aroma personalizado?",
    answer:
      "Cuéntanos qué aroma buscas. Revisamos si podemos prepararlo y te contamos los tiempos.",
  },
  {
    question: "¿Venden al por mayor?",
    answer:
      "Escríbenos y conversamos sobre tu idea, la cantidad y el tipo de producto que necesitas.",
  },
];
---

<BaseLayout
  title="Contacto"
  description="Escríbenos por WhatsApp o correo para pedir velas, resolver dudas o coordinar un pedido."
>
  <PageHero
    eyebrow="Contacto"
    title="Hablemos de velas."
    description="Estamos para ayudarte a elegir, resolver dudas y coordinar tu pedido."
    align="center"
  />

  <section class="section contact">
    <div class="container">
      <div class="contact__grid">
        <article class="contact-card">
          <span class="contact-card__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path>
            </svg>
          </span>
          <h2>WhatsApp</h2>
          <p>La forma más rápida de pedir y resolver dudas.</p>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer">
            Escribir por WhatsApp <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="contact-card">
          <span class="contact-card__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <rect
                x="3"
                y="5"
                width="18"
                height="14"
                rx="3"
                stroke="currentColor"
                stroke-width="1.6"
              ></rect>
              <path
                d="m4 7 8 6 8-6"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
          <h2>Correo</h2>
          <p>Para pedidos especiales o conversaciones con más calma.</p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </article>

        <article class="contact-card">
          <span class="contact-card__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <rect
                x="3"
                y="3"
                width="18"
                height="18"
                rx="5"
                stroke="currentColor"
                stroke-width="1.6"
              ></rect>
              <circle
                cx="12"
                cy="12"
                r="4"
                stroke="currentColor"
                stroke-width="1.6"
              ></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle>
            </svg>
          </span>
          <h2>Instagram</h2>
          <p>Novedades, procesos y aromas nuevos.</p>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">
            Ver perfil <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>

      <div class="contact__info">
        <div>
          <h2>Horario</h2>
          <p>Coordinamos por WhatsApp. Te respondemos lo antes posible.</p>
        </div>
        <div>
          <h2>Entregas</h2>
          <p>
            Envíos y entregas por coordinar según tu ciudad. Escríbenos y te
            contamos las opciones.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq">
    <div class="container faq__inner">
      <div>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Antes de escribirnos</h2>
      </div>

      <div class="faq__list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container contact__cta">
      <p>¿Prefieres que te ayudemos a elegir?</p>
      <WhatsAppCTA />
    </div>
  </section>
</BaseLayout>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-4);
  }

  .contact-card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
  }

  .contact-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .contact-card h2 {
    font-size: var(--text-xl);
  }

  .contact-card p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .contact-card a {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .contact-card a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact__info {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .contact__info h2 {
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact__info p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .faq {
    border-block: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .faq__inner {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .faq h2 {
    margin-top: var(--space-2);
    font-size: var(--text-3xl);
  }

  .faq__list {
    display: grid;
    gap: var(--space-3);
  }

  .faq details {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .faq summary {
    font-weight: 700;
    cursor: pointer;
  }

  .faq details p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .contact__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
  }

  .contact__cta p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  @media (min-width: 760px) {
    .contact__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .contact__info {
      grid-template-columns: 1fr 1fr;
    }

    .faq__inner {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-8);
    }
  }
</style>
