---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscabas no existe o cambió de lugar."
>
  <section class="not-found">
    <div class="container not-found__inner">
      <p class="eyebrow">Error 404</p>
      <p class="not-found__code" aria-hidden="true">
        404
      </p>
      <h1>No encontramos esta página.</h1>
      <p class="not-found__text">
        Puede que el enlace haya cambiado o que la página ya no exista. Te
        dejamos dos caminos para seguir.
      </p>

      <div class="not-found__actions">
        <Button href="/">Volver al inicio</Button>
        <Button href="/productos" variant="secondary">
          Ver insumos
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-9);
    text-align: center;
  }

  .not-found__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }

  .not-found__code {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: clamp(6rem, 20vw, 14rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.06em;
  }

  .not-found h1 {
    font-size: var(--text-3xl);
  }

  .not-found__text {
    max-width: 48ch;
    color: var(--color-text-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
