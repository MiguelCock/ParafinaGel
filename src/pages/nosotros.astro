---
import BaseLayout from "@layouts/BaseLayout.astro";
import FinalCTA from "@components/FinalCTA.astro";
import PageHero from "@components/PageHero.astro";
import StoryVisual from "@components/StoryVisual.astro";

const valores = [
  {
    title: "Materiales probados",
    text: "Probamos ceras, mechas y aromas antes de recomendarlos para tu taller.",
  },
  {
    title: "Recetas claras",
    text: "Te contamos cantidades y pasos para que puedas repetir tu vela con confianza.",
  },
  {
    title: "Atención cercana",
    text: "Te ayudamos a elegir, resolvemos dudas y coordinamos tu pedido por WhatsApp.",
  },
];

const proceso = [
  "Elegimos las materias primas.",
  "Probamos la combinación.",
  "Armamos la receta.",
  "Te acompañamos por WhatsApp.",
];
---

<BaseLayout
  title="Nosotros"
  description="Conoce el taller familiar de ParafinaGel y cómo seleccionamos los insumos para hacer velas."
>
  <PageHero
    eyebrow="Nosotros"
    title="Una familia, un oficio y muchos materiales."
    description="ParafinaGel es un proyecto familiar que comparte ceras, mechas, aromas y moldes para que puedas hacer tus propias velas."
    align="center"
  />

  <section class="section">
    <div class="container split">
      <StoryVisual />

      <div class="about-story">
        <h2>Lo que empezó en casa</h2>
        <p>
          Todo comenzó con una mesa llena de utensilios, pruebas de aromas y
          conversaciones sobre qué hace especial una vela. Poco a poco ese
          experimento se convirtió en un pequeño taller familiar.
        </p>
        <p>
          Hoy seguimos probando combinaciones y seleccionando materiales para
          compartir lo que aprendimos: ceras, mechas, aromas y moldes para que
          armes tus propias velas.
        </p>
      </div>
    </div>
  </section>

  <section class="section values">
    <div class="container">
      <h2 class="values__title">Lo que nos importa</h2>
      <div class="values__grid">
        {valores.map((valor) => (
          <article class="value-card">
            <h3>{valor.title}</h3>
            <p>{valor.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section process">
    <div class="container">
      <div class="process__inner">
        <div>
          <p class="eyebrow">El proceso</p>
          <h2>Cómo preparamos tu pedido</h2>
          <p class="process__intro">
            Cada paso importa. Así seleccionamos y preparamos los materiales que
            llegan a tu taller.
          </p>
        </div>

        <ol class="process__list">
          {proceso.map((paso, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{paso}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .about-story {
    display: grid;
    gap: var(--space-4);
  }

  .about-story h2 {
    font-size: var(--text-3xl);
  }

  .about-story p {
    max-width: 56ch;
    color: var(--color-text-muted);
  }

  .values {
    border-block: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .values__title {
    margin-bottom: var(--space-6);
    font-size: var(--text-3xl);
  }

  .values__grid {
    display: grid;
    gap: var(--space-4);
  }

  .value-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .value-card h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .value-card p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .process__inner {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .process h2 {
    margin-block: var(--space-2) var(--space-3);
    font-size: var(--text-3xl);
  }

  .process__intro {
    max-width: 48ch;
    color: var(--color-text-muted);
  }

  .process__list {
    display: grid;
    gap: var(--space-3);
  }

  .process__list li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
  }

  .process__list span {
    flex: none;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .process__list p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 760px) {
    .values__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .process__inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-8);
    }
  }
</style>
