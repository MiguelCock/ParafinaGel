---
import Logo from "@components/Logo.astro";
import { site } from "@config/site";
import { whatsappLink } from "@lib/whatsapp";

const year = new Date().getFullYear();

const links = [
  { href: "/productos", label: "Insumos" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/juego", label: "Juego" },
  { href: "/contacto", label: "Contacto" },
];

const whatsapp = whatsappLink(
  "Hola, quiero información sobre insumos para velas de ParafinaGel.",
);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" aria-label="ParafinaGel, ir al inicio">
        <Logo size={32} />
        <span>ParafinaGel</span>
      </a>
      <p>{site.tagline}. Materiales, recetas y atención cercana.</p>
    </div>

    <div>
      <h2>Explora</h2>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2>Hablemos</h2>
      <ul>
        <li>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">
            Instagram
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} ParafinaGel. Hecho en familia.</p>
    <p>{site.city} · Precios oficiales de insumos</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-7);
  }

  .site-footer__brand a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-3);
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .site-footer__brand svg {
    color: var(--color-accent);
  }

  .site-footer__brand p {
    max-width: 34ch;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 0.55rem;
  }

  ul a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  ul a:hover {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 760px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }
</style>
