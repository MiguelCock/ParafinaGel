---
import { Image } from "astro:assets";
import type { Producto } from "@lib/products";

interface Props {
  producto: Producto;
  eager?: boolean;
  class?: string;
}

const { producto, eager = false, class: className } = Astro.props;
const imagen = producto.data.imagenes[0];
const categoria = producto.data.categoria;
---

<div class:list={["product-image", className]}>
  {imagen ? (
    <Image
      src={imagen.src}
      alt={imagen.alt}
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  ) : (
    <div
      class:list={["product-placeholder", `product-placeholder--${categoria}`]}
      aria-hidden="true"
    >
      <svg viewBox="0 0 400 500" fill="none" role="presentation">
        <ellipse cx="200" cy="390" rx="120" ry="18" class="ph-shadow" />

        {categoria === "ceras" && (
          <g>
            <path d="M120 220h160v120H120z" class="ph-stroke" />
            <path d="M140 240h120v80H140z" class="ph-soft" />
            <path d="M120 220l30-40h160l-30 40" class="ph-stroke" />
            <path d="M280 220l30-40v120l-30 40" class="ph-stroke" />
          </g>
        )}

        {categoria === "mechas" && (
          <g>
            <circle cx="200" cy="280" r="70" class="ph-stroke" />
            <circle cx="200" cy="280" r="26" class="ph-soft" />
            <path d="M200 350v80" class="ph-stroke" />
          </g>
        )}

        {categoria === "aditivos" && (
          <g>
            <path
              d="M150 210h100v140a20 20 0 0 1-20 20h-60a20 20 0 0 1-20-20z"
              class="ph-stroke"
            />
            <path d="M165 245h70v95h-70z" class="ph-soft" />
            <rect
              x="175"
              y="180"
              width="50"
              height="30"
              rx="6"
              class="ph-stroke"
            />
          </g>
        )}

        {categoria === "aceites" && (
          <g>
            <path
              d="M170 210h60v20l20 30v100a20 20 0 0 1-20 20h-60a20 20 0 0 1-20-20V260l20-30z"
              class="ph-stroke"
            />
            <path d="M175 270h50v80h-50z" class="ph-soft" />
            <rect
              x="185"
              y="175"
              width="30"
              height="35"
              rx="5"
              class="ph-stroke"
            />
          </g>
        )}

        {categoria === "moldes" && (
          <g>
            <path
              d="M130 220c30-50 110-50 140 0v100c0 30-30 50-70 50s-70-20-70-50z"
              class="ph-stroke"
            />
            <path
              d="M160 235c20-30 60-30 80 0v70c0 20-20 30-40 30s-40-10-40-30z"
              class="ph-soft"
            />
          </g>
        )}

        {categoria === "etiquetas" && (
          <g>
            <rect
              x="130"
              y="210"
              width="140"
              height="90"
              rx="10"
              class="ph-stroke"
            />
            <rect
              x="150"
              y="235"
              width="100"
              height="10"
              rx="5"
              class="ph-soft"
            />
            <rect
              x="150"
              y="260"
              width="70"
              height="8"
              rx="4"
              class="ph-soft"
            />
          </g>
        )}

        {categoria === "herramientas" && (
          <g>
            <path d="M150 350l100-130" class="ph-stroke" />
            <circle cx="145" cy="360" r="22" class="ph-stroke" />
            <path d="M235 210l30-30 20 20-30 30" class="ph-stroke" />
          </g>
        )}

        {["envases", "aromas", "colorantes", "kits"].includes(categoria) && (
          <g>
            <rect
              x="120"
              y="220"
              width="160"
              height="130"
              rx="12"
              class="ph-stroke"
            />
            <path d="M120 270h160" class="ph-stroke" />
            <path d="M170 220v-30h60v30" class="ph-stroke" />
            <rect
              x="150"
              y="290"
              width="100"
              height="40"
              rx="8"
              class="ph-soft"
            />
          </g>
        )}

        <text
          x="200"
          y="435"
          text-anchor="middle"
          font-family="Fraunces Variable, Georgia, serif"
          font-size="16"
          font-weight="600"
          fill="var(--color-heading)"
        >
          ParafinaGel
        </text>
      </svg>
    </div>
  )}
</div>

<style>
  .product-image {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .product-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: linear-gradient(
      145deg,
      var(--color-accent-soft),
      var(--color-surface)
    );
  }

  .product-placeholder--ceras {
    background: linear-gradient(
      145deg,
      var(--color-accent-soft),
      var(--color-surface)
    );
  }

  .product-placeholder--mechas {
    background: linear-gradient(
      145deg,
      var(--color-sage-soft),
      var(--color-surface)
    );
  }

  .product-placeholder--aditivos {
    background: linear-gradient(
      145deg,
      var(--color-surface-strong),
      var(--color-bg-elevated)
    );
  }

  .product-placeholder--aceites {
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-sage-soft) 60%, var(--color-surface)),
      var(--color-surface)
    );
  }

  .product-placeholder svg {
    width: 78%;
    height: 78%;
  }

  .ph-stroke {
    fill: none;
    stroke: var(--color-heading);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.5;
  }

  .ph-soft {
    fill: var(--color-bg-elevated);
    opacity: 0.72;
  }

  .ph-flame {
    fill: var(--color-accent);
  }

  .ph-shadow {
    fill: var(--color-heading);
    opacity: 0.08;
  }
</style>
