---
import { Image } from "astro:assets";
import type { Producto } from "@lib/products";

interface Props {
  producto: Producto;
  eager?: boolean;
  class?: string;
}

const { producto, eager = false, class: className } = Astro.props;
const imagen = producto.data.imagenes[0];
const categoria = producto.data.categoria;
---

<div class:list={["product-image", className]}>
  {imagen ? (
    <Image
      src={imagen.src}
      alt={imagen.alt}
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
    />
  ) : (
    <div
      class:list={["product-placeholder", `product-placeholder--${categoria}`]}
      aria-hidden="true"
    >
      <svg viewBox="0 0 400 500" fill="none" role="presentation">
        {categoria === "velas" && (
          <g transform="translate(200 250) scale(1.45)">
            <ellipse cx="0" cy="150" rx="112" ry="18" class="ph-shadow" />
            <path
              d="M-70 -10h140v120a30 30 0 0 1-30 30h-80a30 30 0 0 1-30-30z"
              class="ph-stroke"
            />
            <path
              d="M-58 10h116v70a16 16 0 0 1-16 16h-84a16 16 0 0 1-16-16z"
              class="ph-soft"
            />
            <rect
              x="-34"
              y="34"
              width="68"
              height="34"
              rx="5"
              class="ph-soft"
            />
            <text
              x="0"
              y="55"
              text-anchor="middle"
              font-family="Fraunces Variable, Georgia, serif"
              font-size="12"
              font-weight="600"
              fill="var(--color-heading)"
            >
              ParafinaGel
            </text>
            <path d="M0 -10v-28" class="ph-stroke" />
            <path
              d="M0 -88c16 18 24 30 24 44a24 24 0 1 1-48 0c0-14 8-26 24-44z"
              class="ph-flame"
            />
            <path
              d="M0 -72c6 7 9 12 9 17a9 9 0 1 1-18 0c0-5 3-10 9-17z"
              fill="#f6d36f"
            />
            <path d="M-34 96h68" class="ph-stroke" />
          </g>
        )}

        {categoria === "difusores" && (
          <g transform="translate(200 260) scale(1.3)">
            <ellipse cx="0" cy="150" rx="96" ry="16" class="ph-shadow" />
            <path
              d="M-45 -40h90v170a25 25 0 0 1-25 25h-40a25 25 0 0 1-25-25z"
              class="ph-stroke"
            />
            <path
              d="M-35 -20h70v120a15 15 0 0 1-15 15h-40a15 15 0 0 1-15-15z"
              class="ph-soft"
            />
            <path d="M-30 -40V-150" class="ph-stroke" />
            <path d="M0 -40V-178" class="ph-stroke" />
            <path d="M30 -40V-142" class="ph-stroke" />
            <path d="M-70 45h140" class="ph-stroke" />
          </g>
        )}

        {categoria === "kits" && (
          <g transform="translate(200 260) scale(1.35)">
            <ellipse cx="0" cy="150" rx="118" ry="18" class="ph-shadow" />
            <path d="M-110 -20h220v150h-220z" class="ph-stroke" />
            <path d="M-110 28h220" class="ph-stroke" />
            <path d="M-70 62h60v58h-60z" class="ph-soft" />
            <path d="M20 18h58v102h-58z" class="ph-soft" />
            <path d="M49 18v-22" class="ph-stroke" />
            <path
              d="M49 -4c10 8 16 14 16 22a16 16 0 1 1-32 0c0-8 6-14 16-22z"
              class="ph-flame"
            />
          </g>
        )}

        {categoria === "accesorios" && (
          <g transform="translate(200 260) scale(1.3)">
            <ellipse cx="0" cy="150" rx="108" ry="16" class="ph-shadow" />
            <path d="M-86 -54c44-40 128-40 172 0" class="ph-stroke" />
            <path d="M-64 10l128 104" class="ph-stroke" />
            <path d="M64 10L-64 114" class="ph-stroke" />
            <circle cx="0" cy="62" r="18" class="ph-flame" />
            <path d="M-104 132h208" class="ph-stroke" />
          </g>
        )}
      </svg>
    </div>
  )}
</div>

<style>
  .product-image {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .product-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: linear-gradient(
      145deg,
      var(--color-accent-soft),
      var(--color-surface)
    );
  }

  .product-placeholder--difusores {
    background: linear-gradient(
      145deg,
      var(--color-sage-soft),
      var(--color-surface)
    );
  }

  .product-placeholder--kits {
    background: linear-gradient(
      145deg,
      var(--color-surface-strong),
      var(--color-bg-elevated)
    );
  }

  .product-placeholder--accesorios {
    background: linear-gradient(
      145deg,
      var(--color-border),
      var(--color-surface)
    );
  }

  .product-placeholder svg {
    width: 78%;
    height: 78%;
  }

  .ph-stroke {
    fill: none;
    stroke: var(--color-heading);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.5;
  }

  .ph-soft {
    fill: var(--color-bg-elevated);
    opacity: 0.72;
  }

  .ph-flame {
    fill: var(--color-accent);
  }

  .ph-shadow {
    fill: var(--color-heading);
    opacity: 0.08;
  }
</style>
