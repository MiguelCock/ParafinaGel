---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "whatsapp";
  size?: "default" | "small";
  type?: "button" | "submit" | "reset";
  target?: string;
  rel?: string;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "default",
  type = "button",
  target,
  rel,
  class: className,
} = Astro.props;

const classes = [
  "button",
  `button--${variant}`,
  size === "small" ? "button--small" : undefined,
  className,
];
---

{href ? (
  <a href={href} class:list={classes} target={target} rel={rel}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes}>
    <slot />
  </button>
)}
