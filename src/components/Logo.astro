---
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className } = Astro.props;
---

<svg
  class:list={["logo", className]}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
>
  <circle
    cx="20"
    cy="20"
    r="18.5"
    stroke="currentColor"
    stroke-width="1.4"
    opacity=".3"
  ></circle>
  <path
    d="M20 7.5c2.2 2.6 3.6 4.8 3.6 6.9a3.6 3.6 0 1 1-7.2 0c0-2.1 1.4-4.3 3.6-6.9Z"
    fill="currentColor"
  ></path>
  <path
    d="M20 15.5v3"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
  ></path>
  <rect
    x="14.5"
    y="19"
    width="11"
    height="13"
    rx="3"
    stroke="currentColor"
    stroke-width="1.4"
  ></rect>
  <path
    d="M15.5 25h9"
    stroke="currentColor"
    stroke-width="1.2"
    opacity=".5"
  ></path>
</svg>
